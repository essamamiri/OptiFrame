+/* Hero visual: a live-looking lens scan without adding image assets. */
+.hero {
+  max-width: 930px;
+  min-height: 330px;
+  display: grid;
+  grid-template-columns: 1.05fr .95fr;
+  align-items: center;
+  gap: 28px;
+  margin: 0 auto 26px;
+  padding: 24px 8px 24px 20px;
+}
+.hero-copy { position: relative; z-index: 1; }
+.hero h1 { margin: 17px 0 14px; font-size: clamp(42px, 6vw, 66px); line-height: .99; letter-spacing: -3.8px; }
+.hero p { max-width: 455px; font-size: 16px; line-height: 1.65; }
+.hero-proof { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
+.hero-proof span { display: inline-flex; align-items: center; gap: 7px; padding: 8px 11px; border: 1px solid #29374b; border-radius: 999px; color: #b6c5d8; background: #0d1726cc; font-size: 11px; font-weight: 700; }
+.hero-proof i { width: 6px; height: 6px; border-radius: 50%; background: #72f0cf; box-shadow: 0 0 10px #72f0cf99; }
+.hero-visual { position: relative; height: 300px; overflow: hidden; isolation: isolate; border: 1px solid #2c3f53; border-radius: 25px; background: radial-gradient(ellipse at 50% 50%, #153832 0%, #0e1d2a 48%, #0a111d 100%); box-shadow: inset 0 0 45px #72f0cf0b, 0 24px 60px #0005; }
+.hero-grid { position: absolute; inset: 0; opacity: .27; background-image: linear-gradient(#7db7a60c 1px, transparent 1px), linear-gradient(90deg, #7db7a60c 1px, transparent 1px); background-size: 25px 25px; mask-image: radial-gradient(ellipse, #000 15%, transparent 82%); }
+.hero-orbit { position: absolute; top: 50%; left: 50%; border: 1px solid #72f0cf1e; border-radius: 50%; transform: translate(-50%,-50%); }
+.hero-orbit-outer { width: 270px; height: 270px; }
+.hero-orbit-inner { width: 218px; height: 218px; border-style: dashed; animation: orbit 28s linear infinite; }
+.hero-lens { position: absolute; z-index: 1; top: 50%; left: 50%; width: min(78%, 270px); transform: translate(-50%,-50%); overflow: visible; }
+.hero-measure { position: absolute; z-index: 2; display: grid; gap: 3px; min-width: 90px; padding: 9px 11px; border: 1px solid #72f0cf3b; border-radius: 10px; color: #e6fff8; background: #091621e8; box-shadow: 0 8px 28px #0004; }
+.hero-measure span { color: #8ca9a8; font-size: 9px; font-weight: 800; letter-spacing: 1.3px; }
+.hero-measure b { color: #72f0cf; font-size: 19px; line-height: 1; }
+.hero-measure-width { top: 22px; left: 18px; }
+.hero-measure-height { right: 16px; bottom: 54px; }
+.hero-caption { position: absolute; right: 16px; bottom: 16px; display: flex; align-items: center; gap: 8px; color: #98b2b3; font: 700 9px ui-monospace, monospace; letter-spacing: 1.15px; }
+.hero-live-dot { width: 7px; height: 7px; border-radius: 50%; background: #72f0cf; box-shadow: 0 0 11px #72f0cf; animation: pulse-dot 1.8s ease-in-out infinite; }
+@keyframes orbit { to { transform: translate(-50%,-50%) rotate(360deg); } }
+@keyframes pulse-dot { 50% { opacity: .4; box-shadow: 0 0 2px #72f0cf; } }
+@media (min-width: 800px) { .hero:after { content: none; } }
+@media (max-width: 700px) {
+  .hero { grid-template-columns: 1fr; gap: 20px; padding: 12px 4px 22px; }
+  .hero h1 { font-size: clamp(42px, 11vw, 58px); letter-spacing: -2.8px; }
+  .hero-visual { height: 250px; }
+  .hero-orbit-outer { width: 225px; height: 225px; }
+  .hero-orbit-inner { width: 184px; height: 184px; }
+}
+@media (prefers-reduced-motion: reduce) { .hero-orbit-inner, .hero-live-dot { animation: none; } }
+
 @media (max-width: 520px) {
   .demo-status { grid-template-columns: 1fr; margin-bottom: 18px; }
   .demo-status ul { grid-template-columns: repeat(2, 1fr); }
